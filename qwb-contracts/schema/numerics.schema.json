{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumericsDef",
  "description": "数值路径的精度等级与等价容差（`qwb-data/numerics/<name>.yaml` 的形态）。",
  "type": "object",
  "properties": {
    "citation": {
      "description": "引用来源，至少 1 条；每条需 `title` + `doi` 或 `url`。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "created": {
      "description": "创建/修订时间，ISO 8601 UTC。",
      "type": "string"
    },
    "equivalence_tolerance": {
      "description": "等价容差。",
      "$ref": "#/$defs/EquivalenceTolerance"
    },
    "levels": {
      "description": "精度等级表（至少一级，等级号唯一且递增）。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccuracyLevel"
      }
    },
    "license": {
      "description": "许可声明。",
      "$ref": "#/$defs/License"
    },
    "name": {
      "description": "数据键名（数据目录下的标识）。",
      "type": "string"
    },
    "notes": {
      "description": "备注/来源说明（可选）。",
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "description": "内容摘要（工具生成，见 [`crate::sha256`]）。",
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "description": "数据版本（独立 semver；§8.6 要求变更即 bump）。",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "citation",
    "license",
    "created",
    "levels",
    "equivalence_tolerance"
  ],
  "$defs": {
    "AccuracyLevel": {
      "description": "一个精度等级（K10 / phase-2 §8.5）。",
      "type": "object",
      "properties": {
        "description": {
          "description": "人类可读说明（可选）。",
          "type": [
            "string",
            "null"
          ]
        },
        "grid_level": {
          "description": "推荐的 XC 网格等级名（**引用** `grid/*.yaml` 的 `name`，不重复参数）。",
          "type": "string"
        },
        "level": {
          "description": "等级，`1` 最快、`5` 最准。",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "ps": {
          "description": "pseudospectral 配置；`None` = 该等级不用于 PS 路径。",
          "anyOf": [
            {
              "$ref": "#/$defs/PsSettings"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "grid_level"
      ]
    },
    "Citation": {
      "description": "一条引用来源（§4 K1：每项 `title` + `doi`/`url`）。",
      "type": "object",
      "properties": {
        "doi": {
          "description": "DOI（与 `url` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "文献/数据标题。",
          "type": "string"
        },
        "url": {
          "description": "URL（与 `doi` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "EquivalenceTolerance": {
      "description": "等价容差（K10 条件 ①）：近似路径与解析路径的允许总能量差，单位 Hartree。",
      "type": "object",
      "properties": {
        "pseudospectral": {
          "description": "pseudospectral 路径的容差（比 RI 松，phase-2 §9.3）。",
          "type": "number",
          "format": "double"
        },
        "ri": {
          "description": "RI（密度拟合）路径的容差。",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "ri",
        "pseudospectral"
      ]
    },
    "License": {
      "description": "许可声明（§4 K1 / §8.6：`commercial_ok` / `redistribute_ok` 必须显式）。",
      "type": "object",
      "properties": {
        "commercial_ok": {
          "description": "是否允许商用。",
          "type": "boolean"
        },
        "redistribute_ok": {
          "description": "是否允许再分发。",
          "type": "boolean"
        },
        "spdx": {
          "description": "SPDX 标识（如 `Apache-2.0`、`CC-BY-4.0`）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "spdx",
        "commercial_ok",
        "redistribute_ok"
      ]
    },
    "PsSettings": {
      "description": "pseudospectral 路径的配置（K10；`IN-03` 会消费它）。",
      "type": "object",
      "properties": {
        "collocation_points_per_atom": {
          "description": "每个原子的配点数（pseudospectral 的 collocation grid）。",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "de_aliasing": {
          "description": "是否启用去别名（de-aliasing）。打开之后不许在更高等级关回去。",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "collocation_points_per_atom",
        "de_aliasing"
      ]
    }
  }
}
