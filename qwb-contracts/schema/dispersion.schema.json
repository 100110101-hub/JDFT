{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dispersion",
  "description": "色散参数（`qwb-data/dispersion/*.yaml` 的形态）。",
  "type": "object",
  "properties": {
    "citation": {
      "description": "引用来源，至少 1 条。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "coordination_number": {
      "description": "配位数参数。",
      "$ref": "#/$defs/CoordinationNumber"
    },
    "created": {
      "description": "创建/修订时间，ISO 8601 UTC。",
      "type": "string"
    },
    "damping_parameters": {
      "description": "各泛函的 BJ 阻尼参数（`kind: d3bj` 时非空）。",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DampingParameters"
      },
      "default": {}
    },
    "dispersion": {
      "description": "两点项设置。",
      "$ref": "#/$defs/PairwiseSettings"
    },
    "elements": {
      "description": "覆盖的元素（元素符号，按原子序数升序）。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "description": "数据种类（`d3bj`）。",
      "type": "string"
    },
    "license": {
      "description": "许可声明。",
      "$ref": "#/$defs/License"
    },
    "name": {
      "description": "数据键名。",
      "type": "string"
    },
    "notes": {
      "description": "备注/来源说明（可选）。",
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "description": "溯源。",
      "$ref": "#/$defs/Provenance"
    },
    "r4r2": {
      "description": "每元素的 `sqrt(r4/r2)`：**派生值** `sqrt(0.5·published·sqrt(Z))`（模型消费的就是它）。",
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "double"
      }
    },
    "r4r2_published": {
      "description": "同一元素的公布 `<r⁴>/<r²>`（透明起见一并落盘）。",
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "double"
      }
    },
    "reference": {
      "description": "参考体系插值参数。",
      "$ref": "#/$defs/ReferenceInterpolation"
    },
    "reference_c6": {
      "description": "元素对的参考 C6 表，键是 `高Z-低Z`（如 `H-H`、`O-H`），值 49 个（Ha·Bohr⁶）。",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "reference_cn": {
      "description": "每元素的参考 CN（长度 = 该元素的参考点个数，≤ 7）。",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "sha256": {
      "description": "内容摘要（工具生成，见 [`crate::sha256`]）。",
      "type": [
        "string",
        "null"
      ]
    },
    "vdw_radii_angstrom": {
      "description": "成对 vdW 半径，单位 Å（键 `高Z-低Z`，666 个元素对；零阻尼要它，BJ 不要）。",
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "double"
      },
      "default": {}
    },
    "version": {
      "description": "数据版本（独立 semver）。",
      "type": "string"
    },
    "zero_damping_parameters": {
      "description": "各泛函的零阻尼参数（`kind: d3zero` 时非空）。",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ZeroDampingParameters"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "kind",
    "citation",
    "license",
    "created",
    "elements",
    "coordination_number",
    "reference",
    "r4r2",
    "r4r2_published",
    "reference_cn",
    "reference_c6",
    "dispersion",
    "provenance"
  ],
  "$defs": {
    "Citation": {
      "description": "一条引用来源（§4 K1：每项 `title` + `doi`/`url`）。",
      "type": "object",
      "properties": {
        "doi": {
          "description": "DOI（与 `url` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "文献/数据标题。",
          "type": "string"
        },
        "url": {
          "description": "URL（与 `doi` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "CoordinationModel": {
      "description": "配位数模型（目前只有上游的指数计数函数）。",
      "oneOf": [
        {
          "description": "`count = 1/(1+exp(−kcn·(rc/r − 1)))`。",
          "type": "string",
          "const": "exp"
        }
      ]
    },
    "CoordinationNumber": {
      "description": "配位数参数。",
      "type": "object",
      "properties": {
        "cutoff_bohr": {
          "description": "实空间截断，单位 Bohr。",
          "type": "number",
          "format": "double"
        },
        "kcn": {
          "description": "陡峭度 `kcn`（上游 16）。",
          "type": "number",
          "format": "double"
        },
        "model": {
          "description": "计数函数模型。",
          "$ref": "#/$defs/CoordinationModel"
        },
        "radii_angstrom": {
          "description": "各元素共价半径，单位 Å（键：元素符号）。上游表里金属已经降过 10%。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "scale": {
          "description": "共价半径的缩放（上游 `4/3`，即 D3 用的是 Pyykko 半径的 4/3 倍）。",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "model",
        "kcn",
        "scale",
        "cutoff_bohr",
        "radii_angstrom"
      ]
    },
    "DampingModel": {
      "description": "阻尼函数。",
      "oneOf": [
        {
          "description": "Becke–Johnson 有理阻尼（D3(BJ)）。",
          "type": "string",
          "const": "rational"
        },
        {
          "description": "零阻尼（D3(0)）；数据里还没有（要 vdW 半径表），保留取值位。",
          "type": "string",
          "const": "zero"
        }
      ]
    },
    "DampingParameters": {
      "description": "一个泛函的 BJ 阻尼参数。",
      "type": "object",
      "properties": {
        "a1": {
          "description": "`a1`（乘 `sqrt(C8/C6)`）。",
          "type": "number",
          "format": "double"
        },
        "a2": {
          "description": "`a2`，单位 Bohr。",
          "type": "number",
          "format": "double"
        },
        "doi": {
          "description": "该组参数的出处（DOI）。",
          "type": "string"
        },
        "s6": {
          "description": "`s6`（BJ 下恒为 1）。",
          "type": "number",
          "format": "double"
        },
        "s8": {
          "description": "`s8`。",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "s6",
        "s8",
        "a1",
        "a2",
        "doi"
      ]
    },
    "License": {
      "description": "许可声明（§4 K1 / §8.6：`commercial_ok` / `redistribute_ok` 必须显式）。",
      "type": "object",
      "properties": {
        "commercial_ok": {
          "description": "是否允许商用。",
          "type": "boolean"
        },
        "redistribute_ok": {
          "description": "是否允许再分发。",
          "type": "boolean"
        },
        "spdx": {
          "description": "SPDX 标识（如 `Apache-2.0`、`CC-BY-4.0`）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "spdx",
        "commercial_ok",
        "redistribute_ok"
      ]
    },
    "PairwiseSettings": {
      "description": "两点项的整体设置。",
      "type": "object",
      "properties": {
        "cutoff_bohr": {
          "description": "两点项的实空间截断，单位 Bohr。",
          "type": "number",
          "format": "double"
        },
        "damping": {
          "description": "阻尼模型。",
          "$ref": "#/$defs/DampingModel"
        }
      },
      "additionalProperties": false,
      "required": [
        "damping",
        "cutoff_bohr"
      ]
    },
    "Provenance": {
      "description": "数据的溯源声明。",
      "type": "object",
      "properties": {
        "generator": {
          "description": "生成脚本（仓库相对路径）。",
          "type": "string"
        },
        "upstream": {
          "description": "上游文件清单。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UpstreamSource"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "generator",
        "upstream"
      ]
    },
    "ReferenceInterpolation": {
      "description": "参考体系插值的参数。",
      "type": "object",
      "properties": {
        "weight": {
          "description": "权重模型。",
          "$ref": "#/$defs/WeightModel"
        },
        "wf": {
          "description": "权重宽度 `wf`（上游 4.0）。",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "wf",
        "weight"
      ]
    },
    "UpstreamSource": {
      "description": "一条上游溯源记录。",
      "type": "object",
      "properties": {
        "file": {
          "description": "上游文件相对路径。",
          "type": "string"
        },
        "sha256": {
          "description": "该文件的 sha256。",
          "type": "string"
        },
        "url": {
          "description": "取回地址。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "url",
        "sha256"
      ]
    },
    "WeightModel": {
      "description": "参考体系权重模型。",
      "oneOf": [
        {
          "description": "`w ∝ exp(−wf·(CN_ref − CN)²)`，按最邻近参考点平移后归一化（log-sum-exp）。",
          "type": "string",
          "const": "gaussian"
        }
      ]
    },
    "ZeroDampingParameters": {
      "description": "零阻尼（D3(0)）的参数：`E = −(s6·C6·f6/r⁶ + s8·C8·f8/r⁸)`，\n`f = 1/(1 + 6·t)`、`t6 = (rs6·R0/r)^alp`、`t8 = (rs8·R0/r)^(alp+2)`，\n`R0` 是**成对** vdW 半径（[`Dispersion::vdw_radii_angstrom`]）。\n\n为什么是单独一套字段而不是复用 `DampingParameters`：BJ 用 `a1/a2`，零阻尼用\n`rs6/rs8/alp`，硬塞进一个结构会让「哪个字段对应哪种阻尼」变成约定而不是类型。",
      "type": "object",
      "properties": {
        "alp": {
          "description": "`alp`（默认 14；`t8` 的指数是 `alp + 2`）。",
          "type": "number",
          "format": "double"
        },
        "doi": {
          "description": "该组参数的出处（DOI）。",
          "type": "string"
        },
        "rs6": {
          "description": "`rs6`（D3(0) 的主参数，例如 M06-2X 的 1.619）。",
          "type": "number",
          "format": "double"
        },
        "rs8": {
          "description": "`rs8`。",
          "type": "number",
          "format": "double"
        },
        "s6": {
          "description": "`s6`（D3(0) 下通常为 1）。",
          "type": "number",
          "format": "double"
        },
        "s8": {
          "description": "`s8`（M06-L / M06-2X 是 0）。",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "s6",
        "s8",
        "rs6",
        "rs8",
        "alp",
        "doi"
      ]
    }
  }
}
