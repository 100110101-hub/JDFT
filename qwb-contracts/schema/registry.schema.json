{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegistryManifest",
  "description": "注册表清单。",
  "type": "object",
  "properties": {
    "bases": {
      "description": "基组条目。",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    },
    "created": {
      "description": "创建时间，ISO 8601 UTC。",
      "type": "string"
    },
    "ecps": {
      "description": "ECP 条目。",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    },
    "features": {
      "description": "本数据组合向引擎声明的能力集合（见 `engine-api` 的 feature 词汇表）。",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "functionals": {
      "description": "泛函条目。",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    },
    "grids": {
      "description": "网格条目。",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    },
    "name": {
      "description": "注册表名（如 `qwb-data`）。",
      "type": "string"
    },
    "numerics": {
      "description": "数值路径的精度等级与等价容差条目（阶段二 K10）。",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    },
    "schema_version": {
      "description": "K1 版本（`crate::K1_VERSION`）。",
      "type": "string"
    },
    "solvents": {
      "description": "溶剂条目。",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      }
    },
    "version": {
      "description": "数据仓版本（独立 semver，§8.6）。",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "created"
  ],
  "$defs": {
    "RegistryEntry": {
      "description": "一条数据条目。",
      "type": "object",
      "properties": {
        "name": {
          "description": "数据键名（必须与文件内的 `name` 一致）。",
          "type": "string"
        },
        "path": {
          "description": "相对 `registry.yaml` 所在目录的路径。",
          "type": "string"
        },
        "sha256": {
          "description": "该文件内容的 sha256（与文件内 `sha256` 字段一致）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256"
      ]
    }
  }
}
