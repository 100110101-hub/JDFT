{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solvent",
  "description": "溶剂（`qwb-data/solvent/*.yaml` 的形态）。",
  "type": "object",
  "properties": {
    "atomic_radii": {
      "description": "各元素原子半径，单位 Å（键：元素符号）。",
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "double"
      }
    },
    "cavity_model": {
      "description": "空腔模型。",
      "$ref": "#/$defs/CavityModel"
    },
    "citation": {
      "description": "引用来源，至少 1 条；每条需 `title` + `doi` 或 `url`。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "created": {
      "description": "创建/修订时间，ISO 8601 UTC。",
      "type": "string"
    },
    "epsilon": {
      "description": "相对介电常数 `epsilon`。",
      "type": "number",
      "format": "double"
    },
    "license": {
      "description": "许可声明。",
      "$ref": "#/$defs/License"
    },
    "name": {
      "description": "数据键名（数据目录下的标识）。",
      "type": "string"
    },
    "notes": {
      "description": "备注/来源说明（可选）。",
      "type": [
        "string",
        "null"
      ]
    },
    "scale": {
      "description": "半径缩放因子。",
      "type": "number",
      "format": "double"
    },
    "sha256": {
      "description": "内容摘要（工具生成，见 [`crate::sha256`]）。",
      "type": [
        "string",
        "null"
      ]
    },
    "temperature_K": {
      "description": "温度，单位 K（K1 字段名 `temperature_K`）。",
      "type": "number",
      "format": "double"
    },
    "version": {
      "description": "数据版本（独立 semver；§8.6 要求变更即 bump）。",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "citation",
    "license",
    "created",
    "epsilon",
    "temperature_K",
    "atomic_radii",
    "cavity_model",
    "scale"
  ],
  "$defs": {
    "CavityModel": {
      "description": "空腔模型（§8.5：必须显式声明，禁止隐式默认）。",
      "oneOf": [
        {
          "description": "无空腔（真空；理论上不该作为溶剂条目出现）。",
          "type": "string",
          "const": "none"
        },
        {
          "description": "导体屏蔽模型（C-PCM 一族）。",
          "type": "string",
          "const": "pcm"
        },
        {
          "description": "SMD（§2.2 非目标；保留数据位以便 loader 通过、引擎返回 Unsupported）。",
          "type": "string",
          "const": "smd"
        }
      ]
    },
    "Citation": {
      "description": "一条引用来源（§4 K1：每项 `title` + `doi`/`url`）。",
      "type": "object",
      "properties": {
        "doi": {
          "description": "DOI（与 `url` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "文献/数据标题。",
          "type": "string"
        },
        "url": {
          "description": "URL（与 `doi` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "License": {
      "description": "许可声明（§4 K1 / §8.6：`commercial_ok` / `redistribute_ok` 必须显式）。",
      "type": "object",
      "properties": {
        "commercial_ok": {
          "description": "是否允许商用。",
          "type": "boolean"
        },
        "redistribute_ok": {
          "description": "是否允许再分发。",
          "type": "boolean"
        },
        "spdx": {
          "description": "SPDX 标识（如 `Apache-2.0`、`CC-BY-4.0`）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "spdx",
        "commercial_ok",
        "redistribute_ok"
      ]
    }
  }
}
