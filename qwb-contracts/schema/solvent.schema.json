{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solvent",
  "description": "溶剂（`qwb-data/solvent/*.yaml` 的形态）。",
  "type": "object",
  "properties": {
    "atomic_radii": {
      "description": "各元素原子半径，单位 Å（键：元素符号）。",
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "double"
      }
    },
    "cavity_model": {
      "description": "空腔模型。",
      "$ref": "#/$defs/CavityModel"
    },
    "citation": {
      "description": "引用来源，至少 1 条；每条需 `title` + `doi` 或 `url`。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "created": {
      "description": "创建/修订时间，ISO 8601 UTC。",
      "type": "string"
    },
    "epsilon": {
      "description": "相对介电常数 `epsilon`。",
      "type": "number",
      "format": "double"
    },
    "ionic_strength_molar": {
      "description": "离子强度，单位 mol/L（PBF 用）；`None` = 纯溶剂。",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "license": {
      "description": "许可声明。",
      "$ref": "#/$defs/License"
    },
    "name": {
      "description": "数据键名（数据目录下的标识）。",
      "type": "string"
    },
    "notes": {
      "description": "备注/来源说明（可选）。",
      "type": [
        "string",
        "null"
      ]
    },
    "radii_set": {
      "description": "`atomic_radii` 用的是哪一套半径（Bondi / UFF / SMD）。混用会静默错数，所以必须声明。",
      "anyOf": [
        {
          "$ref": "#/$defs/RadiiSet"
        },
        {
          "type": "null"
        }
      ]
    },
    "refractive_index": {
      "description": "光学介电常数（折射率 `n`；SMD 的非极性项用 `n²`）。",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "scale": {
      "description": "半径缩放因子。",
      "type": "number",
      "format": "double"
    },
    "sha256": {
      "description": "内容摘要（工具生成，见 [`crate::sha256`]）。",
      "type": [
        "string",
        "null"
      ]
    },
    "smd": {
      "description": "SMD 非极性项（可选；缺省 = 该溶剂没有可用的 SMD 参数）。",
      "anyOf": [
        {
          "$ref": "#/$defs/SmdParameters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "surface_tension_cal_per_mol_angstrom2": {
      "description": "表面张力，单位 cal/(mol·Å²)；SMD 的空化项用。",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "temperature_K": {
      "description": "温度，单位 K（K1 字段名 `temperature_K`）。",
      "type": "number",
      "format": "double"
    },
    "version": {
      "description": "数据版本（独立 semver；§8.6 要求变更即 bump）。",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "citation",
    "license",
    "created",
    "epsilon",
    "temperature_K",
    "atomic_radii",
    "cavity_model",
    "scale"
  ],
  "$defs": {
    "CavityModel": {
      "description": "空腔模型（§8.5：必须显式声明，禁止隐式默认）。",
      "oneOf": [
        {
          "description": "无空腔（真空；理论上不该作为溶剂条目出现）。",
          "type": "string",
          "const": "none"
        },
        {
          "description": "导体屏蔽模型（C-PCM 一族）。",
          "type": "string",
          "const": "pcm"
        },
        {
          "description": "SMD（§2.2 非目标；保留数据位以便 loader 通过、引擎返回 Unsupported）。",
          "type": "string",
          "const": "smd"
        }
      ]
    },
    "Citation": {
      "description": "一条引用来源（§4 K1：每项 `title` + `doi`/`url`）。",
      "type": "object",
      "properties": {
        "doi": {
          "description": "DOI（与 `url` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "文献/数据标题。",
          "type": "string"
        },
        "url": {
          "description": "URL（与 `doi` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "License": {
      "description": "许可声明（§4 K1 / §8.6：`commercial_ok` / `redistribute_ok` 必须显式）。",
      "type": "object",
      "properties": {
        "commercial_ok": {
          "description": "是否允许商用。",
          "type": "boolean"
        },
        "redistribute_ok": {
          "description": "是否允许再分发。",
          "type": "boolean"
        },
        "spdx": {
          "description": "SPDX 标识（如 `Apache-2.0`、`CC-BY-4.0`）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "spdx",
        "commercial_ok",
        "redistribute_ok"
      ]
    },
    "RadiiSet": {
      "description": "原子半径所依据的半径集（phase-2 §8.2；**不能混用**不同半径集）。",
      "oneOf": [
        {
          "description": "Bondi van der Waals 半径。",
          "type": "string",
          "const": "bondi"
        },
        {
          "description": "UFF 力场半径。",
          "type": "string",
          "const": "uff"
        },
        {
          "description": "SMD 的参数化半径。",
          "type": "string",
          "const": "smd"
        }
      ]
    },
    "SmdParameters": {
      "description": "**SMD 非极性项**（DA-05 / D0-02）。加性扩展：缺省表示该溶剂没有可用的 SMD 非极性参数。\n\n数据来源是 Minnesota 溶剂化数据库表（Marenich–Cramer–Truhlar, J. Phys. Chem. A 2009,\n`doi:10.1021/jp810292n`，Table 1）—— 数字是数据事实，不是从任何 GPL 源码文件复制的文本。\n\n`nonpolar_terms_available = false` 是**有意义的状态**：water 在该表里\n`gamma/phi²/psi²` 是 `-1` 占位（SMD 对水走单独的 CDS 处理），所以这三个量\n不能当 0 用、也不许编造。",
      "type": "object",
      "properties": {
        "abraham_alpha": {
          "description": "Abraham α（氢键酸性）。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "abraham_beta": {
          "description": "Abraham β（氢键碱性）。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "gamma_mn_per_m": {
          "description": "表面张力 γ（mN/m，数据库原值）。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "nonpolar_terms_available": {
          "description": "该溶剂的 SMD 非极性项是否可用（water 为 `false`）。",
          "type": "boolean"
        },
        "phi_sq": {
          "description": "φ² 参数。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "psi_sq": {
          "description": "ψ² 参数。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "refractive_index_20c": {
          "description": "20 °C 折射率。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "refractive_index_25c": {
          "description": "25 °C 折射率。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "source": {
          "description": "数据来源与说明（含 DOI）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "nonpolar_terms_available"
      ]
    }
  }
}
