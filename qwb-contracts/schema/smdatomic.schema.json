{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmdAtomic",
  "description": "`kind: smd-atomic` 的数据文件。",
  "type": "object",
  "properties": {
    "cds": {
      "description": "CDS 数据。",
      "$ref": "#/$defs/SmdCds"
    },
    "citation": {
      "description": "引用来源。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "created": {
      "description": "创建时间（ISO 8601 UTC）。",
      "type": "string"
    },
    "elements": {
      "description": "覆盖的元素（符号，按原子序数升序）。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "description": "数据种类（恒为 `smd-atomic`）。",
      "type": "string"
    },
    "license": {
      "description": "许可声明。",
      "$ref": "#/$defs/License"
    },
    "name": {
      "description": "数据键名（`smd-atomic`）。",
      "type": "string"
    },
    "notes": {
      "description": "备注。",
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "description": "溯源。",
      "$ref": "#/$defs/SmdAtomicProvenance"
    },
    "sha256": {
      "description": "内容摘要（工具生成）。",
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "description": "数据版本。",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "kind",
    "citation",
    "license",
    "created",
    "elements",
    "cds",
    "provenance"
  ],
  "$defs": {
    "Citation": {
      "description": "一条引用来源（§4 K1：每项 `title` + `doi`/`url`）。",
      "type": "object",
      "properties": {
        "doi": {
          "description": "DOI（与 `url` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "文献/数据标题。",
          "type": "string"
        },
        "url": {
          "description": "URL（与 `doi` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "License": {
      "description": "许可声明（§4 K1 / §8.6：`commercial_ok` / `redistribute_ok` 必须显式）。",
      "type": "object",
      "properties": {
        "commercial_ok": {
          "description": "是否允许商用。",
          "type": "boolean"
        },
        "redistribute_ok": {
          "description": "是否允许再分发。",
          "type": "boolean"
        },
        "spdx": {
          "description": "SPDX 标识（如 `Apache-2.0`、`CC-BY-4.0`）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "spdx",
        "commercial_ok",
        "redistribute_ok"
      ]
    },
    "SmdAtomicProvenance": {
      "description": "溯源。",
      "type": "object",
      "properties": {
        "generator": {
          "description": "生成脚本。",
          "type": "string"
        },
        "upstream": {
          "description": "上游文件（含 sha256）。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UpstreamSource"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "generator",
        "upstream"
      ]
    },
    "SmdCds": {
      "description": "CDS 项的元素级数据。",
      "type": "object",
      "properties": {
        "area_convention": {
          "description": "面积约定（人类可读的形式，如 `A_i = 4*pi*(R_i + offset)^2`）。",
          "type": "string"
        },
        "area_offset_angstrom": {
          "description": "面积约定里的半径偏移（Å）。",
          "type": "number",
          "format": "double"
        },
        "nonaqueous": {
          "description": "非水相参数。",
          "$ref": "#/$defs/SmdNonaqueousSigma"
        },
        "vdw_radii_angstrom": {
          "description": "CDS 用的 vdW 半径（Å）。**不是** SMD 的参数化半径。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "water": {
          "description": "水相参数。",
          "$ref": "#/$defs/SmdWaterSigma"
        }
      },
      "additionalProperties": false,
      "required": [
        "area_convention",
        "area_offset_angstrom",
        "vdw_radii_angstrom",
        "water",
        "nonaqueous"
      ]
    },
    "SmdNonaqueousSigma": {
      "description": "CDS 的非水相参数：σ 是「三张表 × 溶剂 Abraham 描述符」的线性组合，外加一个常数项。",
      "type": "object",
      "properties": {
        "constant_formula": {
          "description": "与元素无关的常数项公式（`CSSIGM`）。",
          "type": "string"
        },
        "descriptor_names": {
          "description": "描述符顺序：`SOLA/SOLB/SOLC/SOLG/SOLH/SOLN`。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hsigma_a": {
          "description": "`HSIGMA_A`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hsigma_b": {
          "description": "`HSIGMA_B`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hsigma_formula": {
          "description": "`HSIGMA` 的拼装公式。",
          "type": "string"
        },
        "hsigma_n": {
          "description": "`HSIGMA_N`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_a": {
          "description": "`SIGMA_A`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_b": {
          "description": "`SIGMA_B`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_formula": {
          "description": "σ 的拼装公式（上游 `mnsol.F` 的原文，人读用）。",
          "type": "string"
        },
        "sigma_mol": {
          "description": "`SIGMA_MOL`（四个系数）。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_n": {
          "description": "`SIGMA_N`（长度 = 元素数）。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "sigma_formula",
        "hsigma_formula",
        "constant_formula",
        "descriptor_names",
        "sigma_n",
        "sigma_a",
        "sigma_b",
        "hsigma_n",
        "hsigma_a",
        "hsigma_b",
        "sigma_mol"
      ]
    },
    "SmdWaterSigma": {
      "description": "CDS 的水相参数（`SIGMA_DATA`）。",
      "type": "object",
      "properties": {
        "hsigma_cal_per_mol_angstrom2": {
          "description": "逐元素的氢修正 `HSIGMA`（cal/(mol·Å²)）。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_cal_per_mol_angstrom2": {
          "description": "逐元素表面张力 σ（cal/(mol·Å²)）。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "sigma_cal_per_mol_angstrom2",
        "hsigma_cal_per_mol_angstrom2"
      ]
    },
    "UpstreamSource": {
      "description": "一条上游溯源记录。",
      "type": "object",
      "properties": {
        "file": {
          "description": "上游文件相对路径。",
          "type": "string"
        },
        "sha256": {
          "description": "该文件的 sha256。",
          "type": "string"
        },
        "url": {
          "description": "取回地址。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "url",
        "sha256"
      ]
    }
  }
}
