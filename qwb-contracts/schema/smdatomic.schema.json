{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmdAtomic",
  "description": "`kind: smd-atomic` 的数据文件。",
  "type": "object",
  "properties": {
    "cds": {
      "description": "CDS 数据。",
      "$ref": "#/$defs/SmdCds"
    },
    "citation": {
      "description": "引用来源。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    },
    "created": {
      "description": "创建时间（ISO 8601 UTC）。",
      "type": "string"
    },
    "elements": {
      "description": "覆盖的元素（符号，按原子序数升序）。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "description": "数据种类（恒为 `smd-atomic`）。",
      "type": "string"
    },
    "license": {
      "description": "许可声明。",
      "$ref": "#/$defs/License"
    },
    "name": {
      "description": "数据键名（`smd-atomic`）。",
      "type": "string"
    },
    "notes": {
      "description": "备注。",
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "description": "溯源。",
      "$ref": "#/$defs/SmdAtomicProvenance"
    },
    "sha256": {
      "description": "内容摘要（工具生成）。",
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "description": "数据版本。",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "kind",
    "citation",
    "license",
    "created",
    "elements",
    "cds",
    "provenance"
  ],
  "$defs": {
    "Citation": {
      "description": "一条引用来源（§4 K1：每项 `title` + `doi`/`url`）。",
      "type": "object",
      "properties": {
        "doi": {
          "description": "DOI（与 `url` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "文献/数据标题。",
          "type": "string"
        },
        "url": {
          "description": "URL（与 `doi` 至少给一个）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "License": {
      "description": "许可声明（§4 K1 / §8.6：`commercial_ok` / `redistribute_ok` 必须显式）。",
      "type": "object",
      "properties": {
        "commercial_ok": {
          "description": "是否允许商用。",
          "type": "boolean"
        },
        "redistribute_ok": {
          "description": "是否允许再分发。",
          "type": "boolean"
        },
        "spdx": {
          "description": "SPDX 标识（如 `Apache-2.0`、`CC-BY-4.0`）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "spdx",
        "commercial_ok",
        "redistribute_ok"
      ]
    },
    "SmdAtomicProvenance": {
      "description": "溯源。",
      "type": "object",
      "properties": {
        "generator": {
          "description": "生成脚本。",
          "type": "string"
        },
        "upstream": {
          "description": "上游文件（含 sha256）。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UpstreamSource"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "generator",
        "upstream"
      ]
    },
    "SmdBonds": {
      "description": "CDS 的**成键接触规则**（上游 `SMXCDS`）：15×15 的参考键长表 + 元素类型映射。\n\n成键权重是 `COT_ij = exp(Δ/(d_ij − (R_ij + Δ)))`（`d ≥ R + Δ` 时为 0），\n`R_ij = rkkval_angstrom[type_i − 1][type_j − 1]`、`Δ = 0.30 Å`；两处特例（O–C 用\n`Δ = 0.10 / R = 1.330`、`ISTS = 6` 时 O–O 用 `Δ = 0.30 / R = 1.80`）写在 `note` 里，\n由实现侧按上游正文落实。类型编号为 0 的元素**不参与**成键权重（`COT ≡ 0`）——\n本文件覆盖的 36 个元素里有 26 个是 0，这与上游 `NATCNV` 一致。",
      "type": "object",
      "properties": {
        "element_types": {
          "description": "元素符号 → 类型编号，1..=15；0 表示不参与成键权重。",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "note": {
          "description": "提取说明与两处特例（人读用）。",
          "type": "string"
        },
        "rkkval_angstrom": {
          "description": "15×15 的参考键长（Å），按上游类型编号索引（0 基：`[类型 − 1][类型 − 1]`）。",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "table": {
          "description": "上游表名（`RKKVAL`）。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "table",
        "note",
        "element_types",
        "rkkval_angstrom"
      ]
    },
    "SmdCds": {
      "description": "CDS 项的元素级数据。",
      "type": "object",
      "properties": {
        "area_convention": {
          "description": "面积约定（人类可读的形式，如 `A_i = 4*pi*(R_i + offset)^2`）。",
          "type": "string"
        },
        "area_offset_angstrom": {
          "description": "面积约定里的半径偏移（Å）。",
          "type": "number",
          "format": "double"
        },
        "bonds": {
          "description": "成键接触规则（`SMXCDS` 的 `COT` 权重）。",
          "$ref": "#/$defs/SmdBonds"
        },
        "nonaqueous": {
          "description": "非水相参数。",
          "$ref": "#/$defs/SmdNonaqueousSigma"
        },
        "vdw_radii_angstrom": {
          "description": "CDS 用的 vdW 半径（Å）。**不是** SMD 的参数化半径。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "water": {
          "description": "水相参数。",
          "$ref": "#/$defs/SmdWaterSigma"
        }
      },
      "additionalProperties": false,
      "required": [
        "area_convention",
        "area_offset_angstrom",
        "vdw_radii_angstrom",
        "water",
        "nonaqueous",
        "bonds"
      ]
    },
    "SmdNonaqueousSigma": {
      "description": "CDS 的非水相参数：σ 是「三张表 × 溶剂 Abraham 描述符」的线性组合，外加一个常数项。",
      "type": "object",
      "properties": {
        "constant_formula": {
          "description": "与元素无关的常数项公式（`CSSIGM`）。",
          "type": "string"
        },
        "descriptor_names": {
          "description": "描述符顺序：`SOLA/SOLB/SOLC/SOLG/SOLH/SOLN`。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hsigma_a": {
          "description": "`HSIGMA_A`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hsigma_b": {
          "description": "`HSIGMA_B`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "hsigma_formula": {
          "description": "`HSIGMA` 的拼装公式。",
          "type": "string"
        },
        "hsigma_n": {
          "description": "`HSIGMA_N`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "pair_sigma_a": {
          "description": "成对修正 `SIGMA_A(101..150)`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "pair_sigma_b": {
          "description": "成对修正 `SIGMA_B(101..150)`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "pair_sigma_n": {
          "description": "成对修正 `SIGMA_N(101..150)`（50 项，含义同 [`SmdWaterSigma`] 的同名字段）。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_a": {
          "description": "`SIGMA_A`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_b": {
          "description": "`SIGMA_B`。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_formula": {
          "description": "σ 的拼装公式（上游 `mnsol.F` 的原文，人读用）。",
          "type": "string"
        },
        "sigma_mol": {
          "description": "`SIGMA_MOL`（四个系数）。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_n": {
          "description": "`SIGMA_N`（长度 = 元素数）。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "sigma_formula",
        "hsigma_formula",
        "constant_formula",
        "descriptor_names",
        "sigma_n",
        "sigma_a",
        "sigma_b",
        "hsigma_n",
        "hsigma_a",
        "hsigma_b",
        "pair_sigma_n",
        "pair_sigma_a",
        "pair_sigma_b",
        "sigma_mol"
      ]
    },
    "SmdWaterSigma": {
      "description": "CDS 的水相参数（`SIGMA_DATA`）。",
      "type": "object",
      "properties": {
        "hsigma_cal_per_mol_angstrom2": {
          "description": "逐元素的氢修正 `HSIGMA`（cal/(mol·Å²)）。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "pair_sigma_cal_per_mol_angstrom2": {
          "description": "成对修正 `SIGMA(101..150)`：第 `k` 项对应 `SIGMA(101 + k)`，即上游的 pair 编号\n`1 + k`（1 = C–C(1)、3 = O–C、5 = N–C(1)、6 = O–N、14 = O–P、16 = N–C 三键）。\n长度固定 50；上游只文档化了 17 个 pair，其余为 0。",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "sigma_cal_per_mol_angstrom2": {
          "description": "逐元素表面张力 σ（cal/(mol·Å²)）。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "sigma_cal_per_mol_angstrom2",
        "hsigma_cal_per_mol_angstrom2",
        "pair_sigma_cal_per_mol_angstrom2"
      ]
    },
    "UpstreamSource": {
      "description": "一条上游溯源记录。",
      "type": "object",
      "properties": {
        "file": {
          "description": "上游文件相对路径。",
          "type": "string"
        },
        "sha256": {
          "description": "该文件的 sha256。",
          "type": "string"
        },
        "url": {
          "description": "取回地址。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "url",
        "sha256"
      ]
    }
  }
}
