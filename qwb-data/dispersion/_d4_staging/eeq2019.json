  "equations": {
    "coulomb_matrix": {
      "diagonal": "A_ii = eta_i + sqrt(2/pi)/rad_i",
      "off_diagonal": "A_ij = erf(sqrt(r_ij^2 * gamma_ij)) / sqrt(r_ij^2),  gamma_ij = 1/(rad_i^2 + rad_j^2)",
      "source": "raw/multicharge/src/multicharge/model/eeq.f90:331-366",
      "quote": {
        "file": "raw/multicharge/src/multicharge/model/eeq.f90",
        "lines": "344-366",
        "text": "   do ipair = 1, npair\n      iat = int(0.5_wp*(sqrt(8.0_wp*real(ipair, wp)+1.0_wp)-1.0_wp))\n      if (iat*(iat+1)/2 < ipair) iat = iat+1\n      jat = ipair-iat*(iat-1)/2\n      izp = mol%id(iat)\n      if (iat == jat) then\n         tmp = self%eta(izp) + sqrt2pi / self%rad(izp)\n      else\n         jzp = mol%id(jat)\n         vec = mol%xyz(:, jat) - mol%xyz(:, iat)\n         r2 = vec(1)**2 + vec(2)**2 + vec(3)**2\n         gam = 1.0_wp / (self%rad(izp)**2 + self%rad(jzp)**2)\n         tmp = erf(sqrt(r2 * gam)) / sqrt(r2)\n      end if\n      amat(jat, iat) = tmp\n      amat(iat, jat) = tmp\n   end do\n   !$omp end parallel do\n\n   amat(mol%nat + 1, 1:mol%nat + 1) = 1.0_wp\n   amat(1:mol%nat + 1, mol%nat + 1) = 1.0_wp\n   amat(mol%nat + 1, mol%nat + 1) = 0.0_wp\nend subroutine get_amat_0d"
      },
      "radii_scaled": false,
      "radii_note": "The kernel uses self%rad(izp) unchanged (eeq.f90:350 and eeq.f90:355); the only charge dependence of the model sits in the RHS via CN and in the reference weighting of D4, not in these radii."
    },
    "rhs": {
      "formula": "x_i = -chi_i + kcnchi_i * CN_i / sqrt(CN_i + 1e-14);  x_{N+1} = Q_total",
      "source": "raw/multicharge/src/multicharge/model/eeq.f90:132-155",
      "quote": {
        "file": "raw/multicharge/src/multicharge/model/eeq.f90",
        "lines": "139-155",
        "text": "   integer :: iat, izp\n   real(wp) :: tmp\n\n   type(eeq_cache), pointer :: ptr\n\n   call view(cache, ptr)\n\n   !$omp parallel do default(none) schedule(runtime) &\n   !$omp shared(mol, self, xvec, ptr) private(iat, izp, tmp)\n   do iat = 1, mol%nat\n      izp = mol%id(iat)\n      tmp = self%kcnchi(izp) / sqrt(ptr%cn(iat) + reg)\n      xvec(iat) = -self%chi(izp) + tmp * ptr%cn(iat)\n   end do\n   xvec(mol%nat + 1) = mol%charge\n\nend subroutine get_xvec"
      },
      "regularization": "reg = 1.0e-14_wp (eeq.f90:137, 163)"
    },
    "linear_system": {
      "formula": "A q = x with A (N+1)x(N+1) and x (N+1); q = first N entries",
      "source": "raw/multicharge/src/multicharge/model/type.F90:227-273",
      "quote": {
        "file": "raw/multicharge/src/multicharge/model/type.F90",
        "lines": "227-273",
        "text": "   ! Setup the Coulomb matrix\n   ndim = mol%nat + 1\n   allocate(amat(ndim, ndim))\n   call self%get_coulomb_matrix(mol, cache, amat)\n\n   ! Get RHS of ES equation\n   allocate(xvec(ndim))\n   call self%get_xvec(mol, cache, xvec)\n\n   vrhs = xvec\n   ainv = amat\n\n   ! Factorize the Coulomb matrix\n   allocate(ipiv(ndim))\n   call sytrf(ainv, ipiv, info=info, uplo=\"l\")\n   if (info /= 0) then\n      call fatal_error(error, \"Bunch-Kaufman factorization failed.\")\n      return\n   end if\n\n   if (cpq) then\n      ! Inverted matrix is needed for coupled-perturbed equations\n      call sytri(ainv, ipiv, info=info, uplo=\"l\")\n      if (info /= 0) then\n         call fatal_error(error, \"Inversion of factorized matrix failed.\")\n         return\n      end if\n      ! Solve the linear system\n      call symv(ainv, xvec, vrhs, uplo=\"l\")\n      do ic = 1, ndim\n         do jc = ic + 1, ndim\n            ainv(ic, jc) = ainv(jc, ic)\n         end do\n      end do\n   else\n      ! Solve the linear system\n      call sytrs(ainv, vrhs, ipiv, info=info, uplo=\"l\")\n      if (info /= 0) then\n         call fatal_error(error, \"Solution of linear system failed.\")\n         return\n      end if\n\n   end if\n\n   if (present(qvec)) then\n      qvec(:) = vrhs(:mol%nat)\n   end if"
      }
    },
    "constraint": {
      "formula": "the extra row/column of ones with a zero corner is a Lagrange multiplier enforcing sum_i q_i = Q_total; A q = x therefore solves the constrained electronegativity equilibration",
      "source": "raw/multicharge/src/multicharge/model/eeq.f90:363-365",
      "quote": {
        "file": "raw/multicharge/src/multicharge/model/eeq.f90",
        "lines": "363-365",
        "text": "   amat(mol%nat + 1, 1:mol%nat + 1) = 1.0_wp\n   amat(1:mol%nat + 1, mol%nat + 1) = 1.0_wp\n   amat(mol%nat + 1, mol%nat + 1) = 0.0_wp"
      },
      "constraint_rhs": "x_{N+1} = mol%charge (eeq.f90:153)"
    },
    "cn_model_used_by_eeq": {
      "model": "plain error-function CN (cn_count%erf), no electronegativity weighting",
      "counting_function": "CN_i = sum_{j!=i} 0.5*(1 + erf(-kcn*(r_ij-rc)/rc)), rc = rcov_i+rcov_j",
      "kcn": 7.5,
      "kcn_default_in_mctc": 3.15,
      "cutoff_bohr": 25.0,
      "cn_max": 8.0,
      "cn_max_application": "CN is smoothly capped with cn' = log(1+exp(cn_max)) - log(1+exp(cn_max-CN)) (mctc-lib ncoord/type.f90:1124-1134); the D4 dispersion CN does NOT use this cap.",
      "rcov_source": "multicharge/src/multicharge/param.f90:65 rcov = get_covalent_rad(mol%num); mctc-lib's accessor returns covalent_rad_d3 = 4/3 * covalent_rad_2009 (mctc-lib data/covrad.f90:63-65, 90-104), i.e. the same 4/3-scaled Pyykko radii the D4 dispersion CN uses",
      "source": "raw/multicharge/src/multicharge/model/eeq.f90:97-98",
      "quote": {
        "file": "raw/multicharge/src/multicharge/model/eeq.f90",
        "lines": "92-99",
        "text": "   self%chi = chi\n   self%rad = rad\n   self%eta = eta\n   self%kcnchi = kcnchi\n\n   call new_ncoord(self%ncoord, mol, cn_count%erf, error, &\n      & cutoff=cutoff, kcn=cn_exp, rcov=rcov, cut=cn_max)\n"
      },
      "setup_constants": {
        "cutoff": 25.0,
        "cn_exp": 7.5,
        "cn_max": 8.0,
        "source": "raw/multicharge/src/multicharge/param.f90:54-56"
      }
    },
    "d4_reference_charge": {
      "formula": "q_ref(Z, ref) = clsq(ref, Z)  (set_refq_eeq)",
      "source": "raw/dftd4/src/dftd4/reference.f90:222-239",
      "note": "The same EEQ model is used to build the D4 reference charges; the molecular charges q_i enter the reference weighting as q_i + zeff_i."
    }
